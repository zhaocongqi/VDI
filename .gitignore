# === 项目特定 ===

# 子项目目录（独立 Git 仓库，不纳入主仓库跟踪）
/kagent/
/kubekey/
/kube-ovn/
/kube-vip/
/kubevirt/
/longhorn/

# 离线资源（build-bundle 下载，不入 git）
package/vdi-os/iso/bundle/

# 构建时自动生成
package/vdi-os/vdi-release.yaml

# 构建产物目录（dist/cache 为符号链接，不加 / 以确保匹配）
bin/
dist
cache
/tmp/

# === 工具配置（本地使用，不入远程）===
.claude/
.codegraph/
.codex/
.vscode/
.vscode-ai-images/
.idea/
*.sw?

# === Python ===
__pycache__/

# === 二进制/磁盘映像 ===
*.iso
*.qcow2
*.img
*.raw
*.vmdk
*.o
*.a
*.so
*.dylib

# === 压缩包 ===
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
*.zip
*.tgz

# === 敏感文件 ===
*.pem
*.key
*.crt
*.p12
*.pfx
.env
.env.local
.env.*.local

# === 临时/日志 ===
*.tmp
*.temp
*~
*.log
*.pid
*.sock
.DS_Store
Thumbs.db
desktop.ini
