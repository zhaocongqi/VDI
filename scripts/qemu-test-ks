#!/bin/bash
# VDI 安装型 ISO (kickstart) qemu 无人值守装机验证
#
# 与 main 分支 elemental Live 型 qemu-test 不同：kickstart ISO 引导后 anaconda
# 按 ks.cfg 自动装机，无人值守，装完 reboot 进系统。无 "Live 环境" 中间态。
#
# 流程:
#   1. qemu (UEFI 或 BIOS) 引导 ISO → anaconda 自动装机（看串口日志）
#   2. 装机完 reboot → 从硬盘引导进系统
#   3. SSH 验证系统装好（MVP1 只验装机，RKE2 在 MVP2）
#
# 注意 ks.cfg reboot 后 qemu 需改为从硬盘引导，否则再次引导 ISO 会循环重装。
# 本脚本用两段式：装机阶段挂 ISO + -boot d；装机完后重启 qemu 去掉 ISO 只挂磁盘。
#
# 用法: ./scripts/qemu-test-ks [ISO路径] [bios|uefi]

set -e

TOP_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." &> /dev/null && pwd )"
ISO="${1:-$(ls -t ${TOP_DIR}/dist/artifacts/vdi-*.iso 2>/dev/null | head -1)}"
BOOT_MODE="${2:-uefi}"

OVMF="/usr/share/ovmf/OVMF.fd"
QEMU_DISK="${QEMU_DISK:-/tmp/qemu-vdi-ks-disk.qcow2}"
QEMU_MEM="${QEMU_MEM:-4096}"   # kickstart 装机无 squashfs live + active.img，4G 够
# 阶段2 系统运行资源（RKE2 + kube-ovn/longhorn/kubevirt 全栈运行，2核4G CPU 不足致
# kube-ovn-controller admission 失败）。装机阶段用 QEMU_MEM/QEMU_SMP，运行阶段用 _RUN。
QEMU_MEM_RUN="${QEMU_MEM_RUN:-8192}"
QEMU_SMP="${QEMU_SMP:-2}"
QEMU_SMP_RUN="${QEMU_SMP_RUN:-4}"
SSH_PORT="${SSH_PORT:-2222}"
VM_IP="127.0.0.1"
VM_USER="root"
VM_PASS="vdi123"

# 装机超时（秒）：BCLinux @core 装机约 5-15 分钟，给足余量
INSTALL_TIMEOUT="${INSTALL_TIMEOUT:-1800}"
# 系统启动超时
BOOT_TIMEOUT="${BOOT_TIMEOUT:-300}"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }

echo "============================================"
echo "  VDI kickstart ISO qemu 装机验证"
echo "  模式: ${BOOT_MODE}"
echo "============================================"

[ -z "$ISO" ] && { error "未找到 ISO，用法: $0 [ISO路径] [bios|uefi]"; exit 1; }
[ ! -f "$ISO" ] && { error "ISO 不存在: $ISO"; exit 1; }
command -v qemu-system-x86_64 >/dev/null || { error "缺 qemu-system-x86_64"; exit 1; }
command -v sshpass >/dev/null || { error "缺 sshpass"; exit 1; }

if [ "$BOOT_MODE" = "uefi" ] && [ ! -f "$OVMF" ]; then
    error "OVMF 不存在: $OVMF（apt install ovmf）"
    exit 1
fi

# KVM 可访问性检测：/dev/kvm 存在但不一定可读（用户需在 kvm 组）
# 若当前会话无 kvm 组（usermod -aG kvm 后未重登录），请用 sg kvm -c 包裹本脚本：
#   sg kvm -c "bash scripts/qemu-test-ks <iso> uefi"
ACCEL=""
if [ -e /dev/kvm ] && [ -r /dev/kvm ]; then
    ACCEL="-accel kvm -cpu host"
else
    warn "无 KVM 访问权限，软件模拟（装机很慢，约 30-60 分钟）"
    warn "若已 usermod -aG kvm，用: sg kvm -c \"bash $0 $ISO $BOOT_MODE\""
fi

info "ISO: $ISO ($(du -h "$ISO" | cut -f1))"
info "磁盘: $QEMU_DISK  内存: ${QEMU_MEM}MB  SSH端口: $SSH_PORT"

# BIOS/UEFI 引导参数
BIOS_ARGS=""
if [ "$BOOT_MODE" = "uefi" ]; then
    BIOS_ARGS="-bios $OVMF"
fi

SERIAL_LOG="/tmp/qemu-ks-serial.log"
QEMU_PID_FILE="/tmp/qemu-ks.pid"

qemu_stop() {
    if [ -f "$QEMU_PID_FILE" ] && kill -0 "$(cat $QEMU_PID_FILE)" 2>/dev/null; then
        kill "$(cat $QEMU_PID_FILE)" 2>/dev/null || true
        sleep 2
    fi
}
trap qemu_stop EXIT

# 干净的磁盘（重装验证时不复用旧盘）
qemu_stop
QEMU_DATA_DISK="/tmp/qemu-vdi-ks-data-disk.qcow2"
if [ "${REUSE_DISK:-0}" != "1" ]; then
    rm -f "$QEMU_DISK" "$QEMU_DATA_DISK"
fi
qemu-img create -f qcow2 "$QEMU_DISK" 60G >/dev/null
qemu-img create -f qcow2 "$QEMU_DATA_DISK" 20G >/dev/null

# ============================================================
# 阶段 1: 引导 ISO → anaconda 自动装机
# ============================================================
info "=== 阶段1: 引导 ISO 装机 ==="
: > "$SERIAL_LOG"

# 产线 ISO 默认装机项走交互 TUI（不带 vdi.install.automatic=true）。
# qemu 无人值守验证需显式注入 automatic 参数：从 ISO 解出 vmlinuz/initrd，
# 用 -kernel/-initrd 直引导 + -append 带 automatic，-cdrom 仍提供 stage2/ks/bundle。
# 这样 -cdrom 引导用的是默认交互项（会被 -kernel 覆盖不走它），automatic 由 -append 注入。
KERNEL_EXTRACT_DIR="/tmp/qemu-ks-kernel"
rm -rf "$KERNEL_EXTRACT_DIR"
mkdir -p "$KERNEL_EXTRACT_DIR"
info "从 ISO 解出 vmlinuz/initrd（供 -kernel 直引导注入 automatic）..."
xorriso -osirrox on -indev "$ISO" \
    -extract /images/pxeboot/vmlinuz "${KERNEL_EXTRACT_DIR}/vmlinuz" \
    -extract /images/pxeboot/initrd.img "${KERNEL_EXTRACT_DIR}/initrd.img" \
    >/dev/null 2>&1 || { error "解出 vmlinuz/initrd 失败"; exit 1; }
VMLINUZ="${KERNEL_EXTRACT_DIR}/vmlinuz"
INITRD="${KERNEL_EXTRACT_DIR}/initrd.img"
[ -s "$VMLINUZ" ] && [ -s "$INITRD" ] || { error "vmlinuz/initrd 解出后为空"; exit 1; }

# -append 显式带 vdi.install.automatic=true 触发无人值守；inst.stage2/inst.ks 仍按 LABEL 寻址（-cdrom 提供）
# INTERACTIVE=1 时不注入 automatic，走图形化交互分支（需人工在 VNC 里配 VDI Network Spoke 后点开始安装）。
# 交互模式需 monitor socket 供 sendkey/screendump 验证键盘响应（当前用 socat）。
# 显示模式：自动模式用 inst.text（无人值守无需图形）；交互模式用 inst.graphical 让 anaconda 渲染 Gtk Hub。
if [ "${INTERACTIVE:-0}" = "1" ]; then
    APPEND="inst.stage2=hd:LABEL=BCLinux.x86_64 inst.ks=hd:LABEL=BCLinux.x86_64:/ks.cfg console=tty1 console=ttyS0,115200 quiet fpi_to_tail=off inst.graphical"
else
    APPEND="inst.stage2=hd:LABEL=BCLinux.x86_64 inst.ks=hd:LABEL=BCLinux.x86_64:/ks.cfg console=ttyS0,115200 console=tty1 quiet fpi_to_tail=off inst.text vdi.install.automatic=true"
fi
info "APPEND=${APPEND}"

# 交互模式启用 monitor socket（供 sendkey/screendump）+ VNC（供人工直连操作）
# 自动模式无需（无人值守，-display none）
MON_ARG=""
DISPLAY_ARG="-display none"
if [ "${INTERACTIVE:-0}" = "1" ]; then
    MON_SOCK="/tmp/qemu-ks-mon"
    rm -f "$MON_SOCK"
    MON_ARG="-monitor unix:${MON_SOCK},server,nowait"
    VNC_PORT="${VNC_PORT:-5900}"
    # VNC 无密码（仅本机调试用，不暴露公网），vnc=:0 监听 5900
    DISPLAY_ARG="-vnc :$((VNC_PORT-5900))"
fi

qemu-system-x86_64 \
    -machine q35 \
    $ACCEL \
    -m "$QEMU_MEM" \
    $BIOS_ARGS \
    -smp "$QEMU_SMP" \
    -drive file="$QEMU_DISK",format=qcow2,if=virtio \
    -drive file="$QEMU_DATA_DISK",format=qcow2,if=virtio \
    -cdrom "$ISO" \
    -kernel "$VMLINUZ" \
    -initrd "$INITRD" \
    -append "$APPEND" \
    -netdev user,id=net0,hostfwd=tcp::$SSH_PORT-:22 \
    -device virtio-net-pci,netdev=net0 \
    -serial file:"$SERIAL_LOG" \
    $MON_ARG \
    $DISPLAY_ARG \
    -daemonize \
    -pidfile "$QEMU_PID_FILE" \
    || { error "qemu 启动失败"; exit 1; }

info "qemu 已启动（PID $(cat $QEMU_PID_FILE)），串口日志: $SERIAL_LOG"
info "等待 anaconda 装机完成（超时 ${INSTALL_TIMEOUT}s）..."

# 装机完成标志（串口日志关键词）：
# - "Installation finished" / "Performing post-installation setup" = 装机收尾
# - "reboot:" / "Power down" = reboot --eject 触发重启
# - "anaconda" 报错行 = 装机失败
# - "login:" / "clear" = 系统启动或准备就绪
# 去控制码后 grep，避免 ANSI 序列干扰匹配
strip_ansi() { sed 's/\x1b\[[0-9;]*[a-zA-Z]//g; s/\x1b\[=?[0-9]*[a-z]//g' "$1"; }

INSTALL_DONE=0
INSTALL_FAIL=0
START=$(date +%s)
# 记录 %pre 结束前的串口行数：ks-include 内容会被 anaconda 回显到串口，
# 包含 %post 探针字面量（如 ">>> [vdi] enable.*完成"），若从头 grep 会误匹配。
# 只在 %pre 之后的输出里搜索装机完成标志，避免误判。
PRE_END_LINE=0

# 交互模式：anaconda 渲染图形 Hub（inst.graphical），需人工在 VNC 里进 VDI Network Spoke
# 配网卡/IP/VIP 后点"开始安装"。Hub 就绪即输出 VNC 信息，继续进入装机监控循环，
# 检测到装机完成后自动切阶段2 硬盘引导。
if [ "${INTERACTIVE:-0}" = "1" ]; then
    info "交互模式：等待 anaconda 图形 Hub 就绪（超时 ${BOOT_TIMEOUT}s）..."
    while :; do
        NOW=$(date +%s); ELAPSED=$((NOW - START))
        if [ $ELAPSED -ge $BOOT_TIMEOUT ]; then
            error "anaconda 启动超时（${BOOT_TIMEOUT}s），检查串口日志与 VNC"
            strip_ansi "$SERIAL_LOG" | tail -30
            exit 1
        fi
        if strip_ansi "$SERIAL_LOG" | grep -qaE "Plymouth switch root|Started Anaconda|anaconda.*started" \
           && [ $ELAPSED -ge 30 ]; then
            info "anaconda 已启动（${ELAPSED}s），图形 Hub 应已在 VNC 渲染"
            info "VNC: vnc://127.0.0.1:${VNC_PORT:-5900}  monitor=${MON_SOCK}"
            info "操作：Hub → SYSTEM 分类 → VDI Network Spoke 配网卡/IP/VIP → 返回 Hub → 开始安装"
            info "脚本将继续监控装机进度，完成后自动切硬盘引导..."
            break
        fi
        if ! kill -0 "$(cat $QEMU_PID_FILE 2>/dev/null)" 2>/dev/null; then
            error "qemu 提前退出，检查串口"
            strip_ansi "$SERIAL_LOG" | tail -30
            exit 1
        fi
        sleep 5
    done
fi

while :; do
    NOW=$(date +%s)
    ELAPSED=$((NOW - START))
    if [ $ELAPSED -ge $INSTALL_TIMEOUT ]; then
        error "装机超时（${INSTALL_TIMEOUT}s）"
        strip_ansi "$SERIAL_LOG" | tail -40
        exit 1
    fi
    # 只看 %pre 之后的输出：ks-include 文本被 anaconda 回显含 %post 探针字面量，
    # 从头 grep 会误匹配 ">>> [vdi] enable.*完成" 致提前切阶段2（磁盘空白引导失败）。
    # 锚点：ks.cfg %pre 尾部 "vdi-installer 日志输出结束" 或 "配置收集完成"。
    if [ "$PRE_END_LINE" -eq 0 ]; then
        PRE_END_LINE=$(strip_ansi "$SERIAL_LOG" | grep -nE "vdi-installer 日志输出结束|配置收集完成" | tail -1 | cut -d: -f1)
        PRE_END_LINE=${PRE_END_LINE:-0}
        if [ "$PRE_END_LINE" -gt 0 ] 2>/dev/null; then
            info "检测到 %pre 结束（串口行 $PRE_END_LINE），开始监控 anaconda 装机..."
        fi
    fi
    SERIAL_AFTER_PRE() {
        local end_line=${PRE_END_LINE:-0}
        if [ "$end_line" -gt 0 ] 2>/dev/null; then
            strip_ansi "$SERIAL_LOG" | tail -n +$((end_line + 1))
        else
            strip_ansi "$SERIAL_LOG"
        fi
    }
    # qemu 进程异常退出
    if ! kill -0 "$(cat $QEMU_PID_FILE 2>/dev/null)" 2>/dev/null; then
        # 装机完 reboot --eject 后无引导目标，qemu 可能退出
        if SERIAL_AFTER_PRE | grep -qiE "Installation (finished|complete)|Performing post-installation|reboot: Restarting system|login:"; then
            info "装机完成（reboot，qemu 退出，${ELAPSED}s）"
            INSTALL_DONE=1
            break
        fi
        warn "qemu 进程退出但未见装机完成标志，检查串口日志"
        strip_ansi "$SERIAL_LOG" | tail -30
        INSTALL_FAIL=1
        break
    fi
    # 关键词判断（仅 %pre 之后的输出）
    # 装机完成标志（按可靠度排序）：
    # - ">>> [vdi] enable.*完成" / ">>> [vdi] %post sysroot END" = 我们的 %post 探针跑完（装机即将 reboot）
    # - "Show Plymouth Reboot Screen" / "reboot: Restarting system" = 装机完触发 reboot
    # - "Installation finished" / "Performing post-installation setup" = anaconda 官方收尾
    if SERIAL_AFTER_PRE | grep -qiE ">>> \[vdi\] %post sysroot END|>>> \[vdi\] enable.*完成|Show Plymouth Reboot Screen|reboot: Restarting system|Installation (finished|complete)|Performing post-installation setup|login:"; then
        info "检测到装机完成标志（${ELAPSED}s）"
        INSTALL_DONE=1
        break
    fi
    if SERIAL_AFTER_PRE | grep -qiE "anaconda.*error|traceback|panic"; then
        error "检测到装机错误（${ELAPSED}s）"
        SERIAL_AFTER_PRE | grep -iE "error|traceback|panic|fail" | tail -20
        INSTALL_FAIL=1
        break
    fi
    # 进度提示（每 60s）
    [ $((ELAPSED % 60)) -eq 0 ] && [ $ELAPSED -gt 0 ] && \
        info "装机中... ${ELAPSED}s（串口末尾: $(strip_ansi "$SERIAL_LOG" | tail -1 | head -c 90)）"
    sleep 15
done

if [ $INSTALL_FAIL -ne 0 ]; then
    exit 1
fi

info "=== 装机阶段完成 ==="
info "串口日志末尾（装机结果）:"
strip_ansi "$SERIAL_LOG" | tail -25

# 显式关闭第一阶段装机时软重启仍在后台运行的 QEMU 进程，防止 PID 锁与端口冲突
qemu_stop

# ============================================================
# 阶段 2: 从硬盘引导进系统
# ============================================================
info "=== 阶段2: 从硬盘引导进系统 ==="
# 保留装机阶段串口日志（含 %pre/%post 探针），阶段2 清空前先备份供诊断
cp -f "$SERIAL_LOG" "${SERIAL_LOG}.install" 2>/dev/null || true
: > "$SERIAL_LOG"
qemu-system-x86_64 \
    -machine q35 \
    $ACCEL \
    -m "$QEMU_MEM_RUN" \
    $BIOS_ARGS \
    -smp "$QEMU_SMP_RUN" \
    -drive file="$QEMU_DISK",format=qcow2,if=virtio \
    -drive file="$QEMU_DATA_DISK",format=qcow2,if=virtio \
    -netdev user,id=net0,hostfwd=tcp::$SSH_PORT-:22 \
    -device virtio-net-pci,netdev=net0 \
    -serial file:"$SERIAL_LOG" \
    -display none \
    -daemonize \
    -pidfile "$QEMU_PID_FILE" \
    || { error "硬盘引导启动失败"; exit 1; }

info "等待系统启动（SSH 可达，超时 ${BOOT_TIMEOUT}s）..."
SSH_OK=0
START=$(date +%s)
for i in $(seq 1 $((BOOT_TIMEOUT/10))); do
    NOW=$(date +%s)
    if [ $((NOW - START)) -ge $BOOT_TIMEOUT ]; then break; fi
    sleep 10
    if sshpass -p "$VM_PASS" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        -o ConnectTimeout=5 -p "$SSH_PORT" "$VM_USER@$VM_IP" "echo OK" 2>/dev/null | grep -q OK; then
        SSH_OK=1
        info "系统已启动（$((NOW - START))s）"
        break
    fi
done

if [ $SSH_OK -eq 0 ]; then
    error "系统未启动（SSH 超时）"
    error "串口日志末尾:"
    tail -30 "$SERIAL_LOG" 2>/dev/null
    exit 1
fi

# ============================================================
# 阶段 3: 验证装机结果
# ============================================================
info "=== 验证装机结果 ==="
sshpass -p "$VM_PASS" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -p "$SSH_PORT" "$VM_USER@$VM_IP" "
echo '---系统---'; uname -r; cat /etc/os-release | grep PRETTY
echo '---/ 挂载---'; mount | grep ' / '
echo '---分区---'; lsblk -o NAME,SIZE,FSTYPE,MOUNTPOINT 2>/dev/null
echo '---数据盘挂载---'; df -h | grep longhorn || echo '数据盘未成功挂载'
echo '---root 登录---'; whoami
echo '---网络---'; ip -4 addr show | grep inet | head -3
echo '---selinux---'; getenforce 2>/dev/null
" 2>&1 | tee /tmp/qemu-ks-check.log

info "============================================"
info "  MVP1 装机验证完成（结果见 /tmp/qemu-ks-check.log）"
info "  qemu PID: $(cat $QEMU_PID_FILE 2>/dev/null)  停止: kill \$(cat $QEMU_PID_FILE)"
info "============================================"
