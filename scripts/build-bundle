#!/bin/bash
set -e

TOP_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." &> /dev/null && pwd )"
SCRIPTS_DIR="${TOP_DIR}/scripts"
PACKAGE_VDI_OS_DIR="${TOP_DIR}/package/vdi-os"
# EKI 集群镜像与 sealer 二进制为客户交付制品，公网不可下载，必须经
# LOCAL_PKG_DIR 或 cache/downloads 提供（登记路径示例：
# /home/zcq/tmp/kubernetes_v1.34.3-eki.2606.0-noncni-amd64/）
: ${EKI_ASSETS_DIR:=}

cd ${TOP_DIR}

source ${SCRIPTS_DIR}/version
source ${SCRIPTS_DIR}/version-eki-k8s
source ${SCRIPTS_DIR}/version-sealer
source ${SCRIPTS_DIR}/version-kubeovn
source ${SCRIPTS_DIR}/version-kubevirt
source ${SCRIPTS_DIR}/version-cdi
source ${SCRIPTS_DIR}/lib/http
source ${SCRIPTS_DIR}/lib/image

BUNDLE_DIR="${PACKAGE_VDI_OS_DIR}/iso/bundle"
IMAGES_DIR="${BUNDLE_DIR}/vdi/images"
IMAGES_LISTS_DIR="${BUNDLE_DIR}/vdi/images-lists"
mkdir -p ${IMAGES_DIR}
mkdir -p ${IMAGES_LISTS_DIR}

# Use offline bundle cache
if [ -n "$VDI_INSTALLER_OFFLINE_BUILD" -a -e /bundle ]; then
  cp -rf /bundle/* ${BUNDLE_DIR}/
  exit 0
fi

# ============================================================
# EKI 集群镜像 + sealer 二进制（客户制品，仅本地获取）
# ============================================================
BINARIES_DIR="${BUNDLE_DIR}/vdi/binaries"
mkdir -p ${BINARIES_DIR}

# 显式指定 EKI_ASSETS_DIR 时优先从该目录拷贝
if [ -n "${EKI_ASSETS_DIR}" ]; then
  for f in "${EKI_K8S_IMAGE_TAR}" "${SEALER_BINARY}" black_white; do
    [ -f "${EKI_ASSETS_DIR}/${f}" ] || { echo "ERROR: EKI 制品缺失: ${EKI_ASSETS_DIR}/${f}" >&2; exit 1; }
    cp "${EKI_ASSETS_DIR}/${f}" "${BINARIES_DIR}/"
  done
else
  # get_url 本地缓存兜底：URL 仅占位，实际必须命中 LOCAL_PKG_DIR/cache/downloads
  get_url "file:///eki/${EKI_K8S_IMAGE_TAR}" "${BINARIES_DIR}/${EKI_K8S_IMAGE_TAR}" \
    || { echo "ERROR: 集群镜像未命中本地缓存: ${EKI_K8S_IMAGE_TAR}（请设置 LOCAL_PKG_DIR 或放入 cache/downloads）" >&2; exit 1; }
  get_url "file:///eki/${SEALER_BINARY}" "${BINARIES_DIR}/${SEALER_BINARY}" \
    || { echo "ERROR: sealer 二进制未命中本地缓存: ${SEALER_BINARY}" >&2; exit 1; }
  get_url "file:///eki/black_white" "${BINARIES_DIR}/black_white" \
    || { echo "ERROR: black_white 未命中本地缓存" >&2; exit 1; }
fi

test -s "${BINARIES_DIR}/${EKI_K8S_IMAGE_TAR}" || { echo "ERROR: 集群镜像为 0 字节" >&2; exit 1; }
test -s "${BINARIES_DIR}/${SEALER_BINARY}" || { echo "ERROR: sealer 二进制为 0 字节" >&2; exit 1; }
chmod +x "${BINARIES_DIR}/${SEALER_BINARY}"
echo "==> EKI cluster image: $(ls -lh ${BINARIES_DIR}/${EKI_K8S_IMAGE_TAR} | awk '{print $5}')"

# ============================================================
# helm 二进制（组件栈 PostGuest 安装用，集群镜像 bin/ 不含 helm）
# ============================================================
HELM_VERSION="v3.16.4"
get_url "https://get.helm.sh/helm-${HELM_VERSION}-linux-${ARCH}.tar.gz" "${BINARIES_DIR}/helm-${HELM_VERSION}-linux-${ARCH}.tar.gz" \
  || echo "WARN: helm 二进制下载失败，组件安装需改用纯 kubectl apply"
test -s "${BINARIES_DIR}/helm-${HELM_VERSION}-linux-${ARCH}.tar.gz" 2>/dev/null \
  && echo "==> helm binary: $(ls -lh ${BINARIES_DIR}/helm-${HELM_VERSION}-linux-${ARCH}.tar.gz | awk '{print $5}')"

# ============================================================
# Kube-OVN images + Helm chart
# ============================================================
CHARTS_DIR="${BUNDLE_DIR}/vdi/charts"
MANIFESTS_DIR="${BUNDLE_DIR}/vdi/manifests"
mkdir -p ${CHARTS_DIR} ${MANIFESTS_DIR}

# Kube-OVN 镜像列表
kubeovn_image_list="${IMAGES_LISTS_DIR}/kube-ovn-${KUBEOVN_VERSION}.txt"
cat > ${kubeovn_image_list} <<EOF
docker.io/kubeovn/kube-ovn:${KUBEOVN_VERSION}
docker.io/kubeovn/vpc-nat-gateway:${KUBEOVN_VERSION}
EOF
save_image ${kubeovn_image_list} ${IMAGES_DIR}

# Kube-OVN Helm chart
kubeovn_chart="${CHARTS_DIR}/kube-ovn-${KUBEOVN_VERSION}.tgz"
get_url "https://github.com/kubeovn/kube-ovn/releases/download/${KUBEOVN_VERSION}/kube-ovn-${KUBEOVN_VERSION}.tgz" ${kubeovn_chart} \
  || get_url "https://kubeovn.github.io/kube-ovn/charts/kube-ovn-${KUBEOVN_VERSION}.tgz" ${kubeovn_chart}

# ============================================================
# KubeVirt images + Helm chart
# ============================================================
kubevirt_image_list="${IMAGES_LISTS_DIR}/kubevirt-${KUBEVIRT_VERSION}.txt"
cat > ${kubevirt_image_list} <<EOF
quay.io/kubevirt/virt-operator:${KUBEVIRT_VERSION}
quay.io/kubevirt/virt-controller:${KUBEVIRT_VERSION}
quay.io/kubevirt/virt-handler:${KUBEVIRT_VERSION}
quay.io/kubevirt/virt-api:${KUBEVIRT_VERSION}
quay.io/kubevirt/virt-launcher:${KUBEVIRT_VERSION}
EOF
save_image ${kubevirt_image_list} ${IMAGES_DIR}

kubevirt_chart="${CHARTS_DIR}/kubevirt-${KUBEVIRT_VERSION}.tgz"
get_url "https://github.com/kubevirt/kubevirt/releases/download/${KUBEVIRT_VERSION}/kubevirt-${KUBEVIRT_VERSION}.tgz" ${kubevirt_chart} \
  || echo "WARN: KubeVirt Helm chart 不存在，使用静态 operator manifest"

# KubeVirt 静态 manifest（operator + CR）
get_url "https://github.com/kubevirt/kubevirt/releases/download/${KUBEVIRT_VERSION}/kubevirt-operator.yaml" ${MANIFESTS_DIR}/kubevirt-operator.yaml
get_url "https://github.com/kubevirt/kubevirt/releases/download/${KUBEVIRT_VERSION}/kubevirt-cr.yaml" ${MANIFESTS_DIR}/kubevirt-cr.yaml

# ============================================================
# CDI images + manifest
# ============================================================
cdi_image_list="${IMAGES_LISTS_DIR}/cdi-${CDI_VERSION}.txt"
cat > ${cdi_image_list} <<EOF
quay.io/kubevirt/cdi-operator:${CDI_VERSION}
quay.io/kubevirt/cdi-controller:${CDI_VERSION}
quay.io/kubevirt/cdi-importer:${CDI_VERSION}
quay.io/kubevirt/cdi-cloner:${CDI_VERSION}
quay.io/kubevirt/cdi-uploadproxy:${CDI_VERSION}
quay.io/kubevirt/cdi-apiserver:${CDI_VERSION}
EOF
save_image ${cdi_image_list} ${IMAGES_DIR}

cdi_chart="${CHARTS_DIR}/cdi-${CDI_VERSION}.tgz"
get_url "https://github.com/kubevirt/containerized-data-importer/releases/download/${CDI_VERSION}/cdi-${CDI_VERSION}.tgz" ${cdi_chart} \
  || echo "WARN: CDI Helm chart 不存在，使用静态 operator manifest"

# CDI 静态 manifest（operator + CR）
get_url "https://github.com/kubevirt/containerized-data-importer/releases/download/${CDI_VERSION}/cdi-operator.yaml" ${MANIFESTS_DIR}/cdi-operator.yaml
get_url "https://github.com/kubevirt/containerized-data-importer/releases/download/${CDI_VERSION}/cdi-cr.yaml" ${MANIFESTS_DIR}/cdi-cr.yaml

echo "==> Build bundle completed (EKI/sealer + Kube-OVN + KubeVirt + CDI)"
ls -la ${BUNDLE_DIR}/vdi/images/ ${BUNDLE_DIR}/vdi/binaries/ ${CHARTS_DIR}/ 2>/dev/null
