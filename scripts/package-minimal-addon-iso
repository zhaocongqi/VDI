#!/bin/bash -e
# 从原始官方 BCLinux ISO 构建极简 Addon 验证 ISO
#
# 关键修复：BCLinux install.img 是嵌套结构:
#   install.img (SquashFS) → LiveOS/rootfs.img (ext4)
# Anaconda 运行根在 rootfs.img 内部，必须 mount 进去注入 Addon。

TOP_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." &> /dev/null && pwd )"
ARTIFACTS_DIR="${TOP_DIR}/dist/artifacts"
CACHE_DIR="${TOP_DIR}/cache"

BCLINUX_ISO="${TOP_DIR}/dist/iso/BCLinux-21.10U5-dvd-x86_64-260610.iso"
ISOHDPFX_BIN="/usr/lib/ISOLINUX/isohdpfx.bin"

MINI_ISO_ROOTFS="${CACHE_DIR}/minimal-iso-rootfs"
MINI_SQUASH_ROOTFS="${CACHE_DIR}/minimal-squash-rootfs"
MINI_ANACONDA_MNT="${CACHE_DIR}/minimal-anaconda-mnt"
ISO_LABEL="BCLinux.x86_64"
ISO_FILE="${ARTIFACTS_DIR}/vdi-minimal-test.iso"

echo "============================================"
echo "  VDI 极简验证 ISO 构建开始"
echo "============================================"

# ============================================================
# 1. 前置命令与依赖自检
# ============================================================
if [ ! -s "${BCLINUX_ISO}" ]; then
    echo "ERROR: 缺少 BCLinux 原生 ISO: ${BCLINUX_ISO}" >&2
    exit 1
fi
command -v xorriso >/dev/null 2>&1 || { echo "ERROR: 缺少 xorriso" >&2; exit 1; }
command -v unsquashfs >/dev/null 2>&1 || { echo "ERROR: 缺少 unsquashfs" >&2; exit 1; }
command -v mksquashfs >/dev/null 2>&1 || { echo "ERROR: 缺少 mksquashfs" >&2; exit 1; }
if [ ! -s "${ISOHDPFX_BIN}" ]; then
    echo "ERROR: 缺少 syslinux isohdpfx.bin: ${ISOHDPFX_BIN}" >&2
    exit 1
fi

mkdir -p "${ARTIFACTS_DIR}"
echo ">>> 清理旧的极简验证 ISO"
rm -f "${ISO_FILE}" "${ISO_FILE}.sha512"

# ============================================================
# 2. 解包官方原生 DVD ISO
# ============================================================
echo ">>> 解包官方原生 BCLinux ISO"
if [ -d "${MINI_ISO_ROOTFS}" ]; then
    chmod -R u+w "${MINI_ISO_ROOTFS}" 2>/dev/null || true
    rm -rf "${MINI_ISO_ROOTFS}"
fi
mkdir -p "${MINI_ISO_ROOTFS}"
xorriso -osirrox on -indev "${BCLINUX_ISO}" -extract / "${MINI_ISO_ROOTFS}"
chmod -R u+w "${MINI_ISO_ROOTFS}" 2>/dev/null || true

# ============================================================
# 3. 解包 install.img (SquashFS 外层) → 获取 LiveOS/rootfs.img
# ============================================================
echo ">>> 解压 install.img (SquashFS 外层)"
if [ -d "${MINI_SQUASH_ROOTFS}" ]; then
    rm -rf "${MINI_SQUASH_ROOTFS}"
fi
unsquashfs -d "${MINI_SQUASH_ROOTFS}" "${MINI_ISO_ROOTFS}/images/install.img"

# ============================================================
# 4. 挂载 rootfs.img (ext4 内层) 并注入 VDI Addon
# ============================================================
ROOTFS_IMG="${MINI_SQUASH_ROOTFS}/LiveOS/rootfs.img"
if [ ! -f "${ROOTFS_IMG}" ]; then
    echo "ERROR: 未找到 LiveOS/rootfs.img，install.img 结构不符合预期" >&2
    exit 1
fi

echo ">>> 挂载 rootfs.img (ext4) 并注入 VDI Addon"
# 动态创建 loop 块设备节点，以保证特权 Docker 容器内能正常建立 loop 挂载绑定
for i in {0..7}; do
    if [ ! -b "/dev/loop$i" ]; then
        mknod "/dev/loop$i" b 7 $i 2>/dev/null || true
    fi
done

mkdir -p "${MINI_ANACONDA_MNT}"
mount -o loop "${ROOTFS_IMG}" "${MINI_ANACONDA_MNT}"

# 确认原生 addons 目录存在（应有 com_redhat_kdump）
if [ ! -d "${MINI_ANACONDA_MNT}/usr/share/anaconda/addons" ]; then
    echo "ERROR: rootfs.img 中不存在 /usr/share/anaconda/addons 目录" >&2
    umount "${MINI_ANACONDA_MNT}"
    exit 1
fi

echo "  现有插件: $(ls "${MINI_ANACONDA_MNT}/usr/share/anaconda/addons/")"
cp -r "${TOP_DIR}/package/vdi-os/anaconda/addons/vdi" "${MINI_ANACONDA_MNT}/usr/share/anaconda/addons/"
echo "  注入后插件: $(ls "${MINI_ANACONDA_MNT}/usr/share/anaconda/addons/")"

# 注入 DBus 服务声明与权限配置（缺少这两个文件 Boss 无法发现 Addon 服务）
VDI_DBUS_DIR="${TOP_DIR}/package/vdi-os/anaconda/addons/vdi/dbus"
cp "${VDI_DBUS_DIR}/org.fedoraproject.Anaconda.Addons.Vdi.service" \
   "${MINI_ANACONDA_MNT}/usr/share/anaconda/dbus/services/"
cp "${VDI_DBUS_DIR}/org.fedoraproject.Anaconda.Addons.Vdi.conf" \
   "${MINI_ANACONDA_MNT}/usr/share/anaconda/dbus/confs/"
echo "  DBus 服务文件已注入"

# 声明式隐藏 Anaconda 自带的原生“网络与主机名 (NetworkSpoke)”页面，避免与 VDI 网络插件冲突
MINI_PROFILE_CONF="${MINI_ANACONDA_MNT}/etc/anaconda/profile.d/bclinux.conf"
if [ -f "${MINI_PROFILE_CONF}" ]; then
    echo "  改写 bclinux.conf，隐藏原生网络配置界面 (NetworkSpoke)"
    sed -i '/\[User Interface\]/a hidden_spokes = NetworkSpoke' "${MINI_PROFILE_CONF}"
else
    echo "WARN: 未找到 profile 配置文件 ${MINI_PROFILE_CONF}，原生网络界面可能无法隐藏" >&2
fi

# 同步文件系统并卸载
sync
umount "${MINI_ANACONDA_MNT}"
rmdir "${MINI_ANACONDA_MNT}" 2>/dev/null || true

# ============================================================
# 5. 重新封装 install.img (SquashFS)
# ============================================================
echo ">>> 重新封装 install.img"
rm -f "${MINI_ISO_ROOTFS}/images/install.img"
mksquashfs "${MINI_SQUASH_ROOTFS}" "${MINI_ISO_ROOTFS}/images/install.img" -comp xz
rm -rf "${MINI_SQUASH_ROOTFS}"

# ============================================================
# 6. 注入极简测试 ks.cfg
# ============================================================
echo ">>> 注入极简测试 ks.cfg"
cat > "${MINI_ISO_ROOTFS}/ks.cfg" <<'KS_CFG'
# 极简测试 Kickstart（验证 GUI Addon 显示 + hot-reload）
graphical
cdrom
keyboard --vckeymap=us --xlayouts='us'
lang zh_CN.UTF-8
timezone Asia/Shanghai --isUtc
rootpw vdi123
network --bootproto=dhcp --device=link --activate
clearpart --all --initlabel
autopart --type=lvm --fstype=ext4
bootloader --append="console=tty1 console=ttyS0,115200"

%pre --nochroot
echo "root:vdi123" | chpasswd
%end

%addon vdi
%end
KS_CFG

# ============================================================
# 7. 改写引导菜单强开图形 GUI
# ============================================================
echo ">>> 改写引导配置文件"
chmod u+w "${MINI_ISO_ROOTFS}/isolinux/isolinux.cfg" "${MINI_ISO_ROOTFS}/EFI/BOOT/grub.cfg"

cat > "${MINI_ISO_ROOTFS}/isolinux/isolinux.cfg" <<'ISO_MENU'
default vdi
timeout 30
prompt 0

label vdi
  menu label ^Install VDI Addon Test (graphical)
  menu default
  kernel vmlinuz
  append initrd=initrd.img inst.stage2=hd:LABEL=BCLinux.x86_64 inst.ks=hd:LABEL=BCLinux.x86_64:/ks.cfg console=tty1 console=ttyS0,115200 quiet fpi_to_tail=off inst.graphical inst.sshd
ISO_MENU

cat > "${MINI_ISO_ROOTFS}/EFI/BOOT/grub.cfg" <<'GRUB_MENU'
set default="0"
set timeout=5

function load_video {
  insmod efi_gop
  insmod efi_uga
  insmod all_video
}
load_video
set gfxpayload=keep
insmod gzio
insmod part_gpt
insmod ext2
search --no-floppy --set=root -l 'BCLinux.x86_64'

menuentry 'Install VDI Addon Test (graphical)' --class gnu-linux --class os {
  set linux=linuxefi
  set initrd=initrdefi
  if [ "${grub_platform}" != "efi" ]; then
    set linux=linux
    set initrd=initrd
  fi
  $linux /images/pxeboot/vmlinuz inst.stage2=hd:LABEL=BCLinux.x86_64 inst.ks=hd:LABEL=BCLinux.x86_64:/ks.cfg console=tty1 console=ttyS0,115200 quiet fpi_to_tail=off inst.graphical inst.sshd
  $initrd /images/pxeboot/initrd.img
}
GRUB_MENU

EFIIMG="${MINI_ISO_ROOTFS}/images/efiboot.img"
if [ -f "${EFIIMG}" ] && command -v mtools >/dev/null 2>&1; then
    mcopy -o -i "${EFIIMG}" "${MINI_ISO_ROOTFS}/EFI/BOOT/grub.cfg" ::EFI/BOOT/grub.cfg 2>/dev/null || true
fi

# ============================================================
# 8. xorriso 封包生成测试 ISO
# ============================================================
echo ">>> xorriso 封装测试 ISO"
xorriso -as mkisofs \
    -o "${ISO_FILE}" \
    -V "${ISO_LABEL}" \
    -J -R -joliet-long \
    -b isolinux/isolinux.bin \
    -c isolinux/boot.cat \
    -no-emul-boot -boot-load-size 4 -boot-info-table \
    -isohybrid-mbr "${ISOHDPFX_BIN}" \
    -eltorito-alt-boot \
    -e "images/efiboot.img" \
    -no-emul-boot -isohybrid-gpt-basdat \
    "${MINI_ISO_ROOTFS}"

rm -rf "${MINI_ISO_ROOTFS}"

cd "${ARTIFACTS_DIR}"
sha512sum "vdi-minimal-test.iso" > "vdi-minimal-test.sha512"

echo "============================================"
echo "  极简验证 ISO 构建完成!"
echo "  ISO:   ${ISO_FILE}"
echo "  大小:  $(du -sh "${ISO_FILE}" | cut -f1)"
echo "  SHA512:vdi-minimal-test.sha512"
echo ""
echo "  调试提示:"
echo "  装机时按 Ctrl+Alt+F2 进入 shell，查看："
echo "    /tmp/anaconda.log        — 主日志"
echo "    /tmp/syslog               — 系统日志"
echo "    journalctl -b             — 全部 journal"
echo "    ls /usr/share/anaconda/addons/  — 确认插件注入"
echo "============================================"
