#!/bin/bash

# 使用 skopeo 将镜像列表中的所有镜像打包为 docker-archive 格式的 tar，再 zst 压缩。
# 镜像列表文件每行一个镜像（完整 registry/repo:tag 格式）。

save_image()
{
  local image_list=$1
  local save_dir=$2

  local archive_name="$(basename ${image_list%.txt}).tar"
  local archive_file="${save_dir}/${archive_name}"
  local zst_file="${archive_file}.zst"

  if [ -f "$zst_file" ]; then
    echo "Archive already exists: ${zst_file}"
    return 0
  fi

  local images=($(<${image_list}))
  if [ ${#images[@]} -eq 0 ]; then
    echo "WARN: No images in ${image_list}, skipping archive"
    return 0
  fi

  echo "Copying ${#images[@]} images via skopeo..."

  # skopeo 多镜像打包：先 copy 第一个镜像创建 archive，后续用 --append 追加
  local first=1
  for image in "${images[@]}"; do
    if [ $first -eq 1 ]; then
      skopeo copy docker://$image docker-archive:${archive_file} --override-os linux --override-arch amd64
      first=0
    else
      skopeo copy docker://$image docker-archive:${archive_file} --override-os linux --override-arch amd64 --append
    fi
  done

  zstd --rm $archive_file
}
