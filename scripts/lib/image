#!/bin/bash

# 使用 skopeo 将镜像列表中的所有镜像打包为 docker-archive 格式的 tar，再 zst 压缩。
# 镜像列表文件每行一个镜像（完整 registry/repo:tag 格式）。

save_image()
{
  local image_list=$1
  local save_dir=$2

  local archive_name="$(basename ${image_list%.txt}).tar"
  local archive_file="${save_dir}/${archive_name}"
  local zst_file="${archive_file}.zst"

  if [ -f "$zst_file" ]; then
    echo "Archive already exists: ${zst_file}"
    return 0
  fi

  local images=($(<${image_list}))
  if [ ${#images[@]} -eq 0 ]; then
    echo "WARN: No images in ${image_list}, skipping archive"
    return 0
  fi

  echo "Copying ${#images[@]} images via skopeo..."

  # skopeo 逐镜像打包为独立 docker-archive tar，RKE2 导入时自动扫描目录下所有 .tar.zst
  for image in "${images[@]}"; do
    local img_tag="${image##*:}"
    local img_repo="${image%:*}"
    local img_name="$(echo "${img_repo}" | sed 's|[^a-zA-Z0-9._-]|_|g')_${img_tag}"
    local img_archive="${save_dir}/${img_name}.tar"
    local img_zst="${img_archive}.zst"
    if [ -f "$img_zst" ]; then
      echo "  已存在: ${img_zst}"
      continue
    fi
    echo "  拉取: ${image}"
    skopeo copy docker://$image docker-archive:${img_archive} --override-os linux --override-arch amd64
  done

  # 批量压缩所有 tar 为 tar.zst
  for tar_file in ${save_dir}/*.tar; do
    [ -f "$tar_file" ] || continue
    zstd --rm "$tar_file"
  done
}
