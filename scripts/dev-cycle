#!/bin/bash -e
# ============================================================
# VDI Addon 开发循环脚本
# ============================================================
#
# 子命令：
#   start   — 构建极简 ISO + 启动 qemu 交互模式（首次使用）
#   reload  — 热重载 addon 代码到运行中的安装器（改代码后用）
#   verify  — 验证装机结果（安装完成后用）
#
# 使用方式：
#   ./scripts/dev-cycle start
#   ./scripts/dev-cycle reload
#   ./scripts/dev-cycle verify

TOP_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." &> /dev/null && pwd )"
SCRIPTS_DIR="${TOP_DIR}/scripts"
ARTIFACTS_DIR="${TOP_DIR}/dist/artifacts"
MINIMAL_ISO="${ARTIFACTS_DIR}/vdi-minimal-test.iso"

SSH_HOST="127.0.0.1"
SSH_PORT="2222"
SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -p ${SSH_PORT}"
VM_PASS="vdi123"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

cmd_start() {
    info "=== 构建极简验证 ISO ==="
    sudo -E bash "${SCRIPTS_DIR}/package-minimal-addon-iso"

    if [ ! -f "${MINIMAL_ISO}" ]; then
        error "极简 ISO 构建失败: ${MINIMAL_ISO}"
        exit 1
    fi
    sudo chown -R "$(id -u):$(id -g)" "${TOP_DIR}/cache" "${MINIMAL_ISO}" 2>/dev/null || true
    info "极简 ISO 构建完成: ${MINIMAL_ISO}"

    info "=== 启动 qemu 交互模式 ==="
    INTERACTIVE=1 VM_PASS="${VM_PASS}" bash "${SCRIPTS_DIR}/qemu-test-ks" "${MINIMAL_ISO}" uefi &
    QEMU_PID=$!

    info "等待 anaconda Hub 就绪..."
    for i in $(seq 1 60); do
        sleep 5
        if strip_ansi_check; then
            break
        fi
    done

    echo ""
    info "============================================"
    info "  开发环境已就绪！"
    info "  VNC:  vnc://127.0.0.1:5900"
    info "  SSH:  ssh ${SSH_OPTS} root@${SSH_HOST}"
    info ""
    info "  操作流程："
    info "  1. 通过 VNC 进入安装器 Hub"
    info "  2. 修改 addon 代码后执行: ./scripts/dev-cycle reload"
    info "  3. 在 VNC 中点「开始安装」"
    info "  4. 安装完成后执行: ./scripts/dev-cycle verify"
    info "============================================"

    # 等待 qemu 进程结束
    wait $QEMU_PID 2>/dev/null || true
}

strip_ansi_check() {
    # 检查串口日志是否包含 anaconda 启动标志
    if [ -f /tmp/qemu-ks-serial.log ]; then
        if grep -qaE "Plymouth switch root|Started Anaconda" /tmp/qemu-ks-serial.log 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

cmd_reload() {
    info "=== 热重载 Addon 代码 ==="
    bash "${SCRIPTS_DIR}/hot-reload-addon" "${SSH_HOST}" "${SSH_PORT}"
    info "热重载完成！请在 VNC 中观察界面更新。"
}

cmd_verify() {
    info "=== 验证装机结果 ==="

    local checks=(
        "/usr/local/bin/rke2:RKE2 二进制"
        "/etc/rancher/rke2/config.yaml:RKE2 配置"
        "/etc/ssh/sshd_config.d/00-vdi-root-login.conf:SSH root 登录配置"
        "/etc/vdi/network.conf:VDI 网络配置"
        "/var/lib/rancher/rke2/agent/images:RKE2 离线镜像目录"
        "/usr/local/bin/kubectl:kubectl 软链"
        "/etc/profile.d/rke2.sh:RKE2 PATH 配置"
        "/root/.kube/config:root kubeconfig"
    )

    local pass=0
    local fail=0

    for check in "${checks[@]}"; do
        local path="${check%%:*}"
        local desc="${check##*:}"
        if ssh ${SSH_OPTS} root@${SSH_HOST} "test -e ${path}" 2>/dev/null; then
            echo -e "  ${GREEN}✓${NC} ${desc} (${path})"
            ((pass++))
        else
            echo -e "  ${RED}✗${NC} ${desc} (${path})"
            ((fail++))
        fi
    done

    # 检查 rke2-server 服务状态
    local svc_status
    svc_status=$(ssh ${SSH_OPTS} root@${SSH_HOST} "systemctl is-active rke2-server" 2>/dev/null || echo "unknown")
    if [ "$svc_status" = "active" ]; then
        echo -e "  ${GREEN}✓${NC} rke2-server 服务 (${svc_status})"
        ((pass++))
    else
        echo -e "  ${YELLOW}○${NC} rke2-server 服务 (${svc_status})"
    fi

    echo ""
    info "验证结果: ${pass} 通过, ${fail} 失败"

    if [ $fail -eq 0 ]; then
        info "所有检查通过！"
    else
        warn "部分检查失败，请检查 VdiInstallationTask 日志"
    fi
}

# 主入口
case "${1:-}" in
    start)
        cmd_start
        ;;
    reload)
        cmd_reload
        ;;
    verify)
        cmd_verify
        ;;
    *)
        echo "用法: $0 {start|reload|verify}"
        echo ""
        echo "  start   构建极简 ISO + 启动 qemu 交互模式"
        echo "  reload  热重载 addon 代码到运行中的安装器"
        echo "  verify  验证装机结果"
        exit 1
        ;;
esac
